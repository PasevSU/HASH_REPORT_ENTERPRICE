# Copy to watcher.env (next to the script). Real environment variables win over this file.
REPO_PATH=
# Empty BRANCH = current branch of the repository
BRANCH=
# 0 = dry run (only reports changes), 1 = auto commit + push of TRACKED files
APPLY=0
POLL_INTERVAL=5
DEBOUNCE=30
# Block commits containing private keys / tokens / .env / *.pem files
SECRET_SCAN=1
# 1 = also stage NEW (untracked) files, not only modified/deleted tracked files
STAGE_UNTRACKED=0
# Max wait (seconds) between retries after a failure
MAX_BACKOFF=900
# LOG_FILE=

# --- Windows <-> HA coordination (lease) ---
# Only one node may write per branch. LEASE only active with APPLY=1. Requires NTP-synced clocks.
LEASE=1
LEASE_TTL=180
LEASE_GRACE=30
FOLLOW=1
FOLLOW_INTERVAL=30
NODE_ID=
